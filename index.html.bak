            <p class="footer-c-val"><span style="color:var(--text-dark);font-weight:700;">Sheik</span></p>
          </div>
          <div class="footer-contact-row">
            <p class="footer-c-lbl">WhatsApp Number</p>
            <p class="footer-c-val"><a href="https://wa.me/916383816372" target="_blank" rel="noopener noreferrer">63838 16372</a></p>
          </div>
          <div class="footer-contact-row">
            <p class="footer-c-lbl">Email Address</p>
            <p class="footer-c-val"><a href="mailto:aladdinsevents15@gmail.com">aladdinsevents15@gmail.com</a></p>
          </div>
        </div>

      </div>

      <div class="footer-bottom-bar">
        <p>&copy; <span id="copyrightYear"></span> ALADDIN'S &ndash; Event Management &amp; Catering Services. All rights reserved.</p>
        <p>Prepared with authentic ingredients, genuine hospitality, and personal care.</p>
      </div>
    </div>
  </footer>

  <!-- ==========================================================================
       CINEMATIC LIGHTBOX MODAL (NO CROPPING)
       ========================================================================== -->
  <div id="lightboxModal" role="dialog" aria-label="Poster and Image Viewer" aria-modal="true" tabindex="-1">
    <button class="lb-close-trigger" id="lbCloseBtn" aria-label="Close poster view" title="Close (Escape)">&times;</button>
    <button class="lb-nav-trigger lb-nav-prev" id="lbPrevBtn" aria-label="Previous poster" title="Previous (Left Arrow)">&#8249;</button>
    
    <div class="lightbox-holder" id="lbContentHolder">
      <div class="lightbox-image-box">
        <img id="lbImageElement" src="" alt="Full resolution poster" />
      </div>
      <div class="lb-caption-holder">
        <span class="lb-caption-tag" id="lbTagElement"></span>
        <h3 class="lb-caption-title" id="lbTitleElement"></h3>
        <p class="lb-caption-counter" id="lbCounterElement"></p>
      </div>
    </div>

    <button class="lb-nav-trigger lb-nav-next" id="lbNextBtn" aria-label="Next poster" title="Next (Right Arrow)">&#8250;</button>
  </div>

  <!-- FLOATING WHATSAPP BUTTON (SHEIK: 63838 16372) -->
  <a href="https://wa.me/916383816372" target="_blank" rel="noopener noreferrer" class="floating-whatsapp-widget" aria-label="Chat directly with Sheik on WhatsApp at 63838 16372">
    <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
    </svg>
    <span class="floating-whatsapp-tooltip">Chat with Sheik &bull; 63838 16372</span>
  </a>

  <!-- ==========================================================================
       JAVASCRIPT LOGIC
       ========================================================================== -->
  <script>
    // 1. Dynamic Year in Footer
    document.getElementById("copyrightYear").textContent = new Date().getFullYear();

    // 2. Sticky Navbar & Active Section Tracker
    const navbar = document.getElementById("navbar");
    const navLinks = document.querySelectorAll(".nav-link-btn");
    const sections = document.querySelectorAll("main section, section#hero");

    window.addEventListener("scroll", () => {
      const scrollPos = window.scrollY;
      navbar.classList.toggle("scrolled", scrollPos > 50);

      sections.forEach(section => {
        const top = section.offsetTop - 120;
        const height = section.offsetHeight;
        const id = section.getAttribute("id");
        if (scrollPos >= top && scrollPos < top + height) {
          navLinks.forEach(link => {
            link.classList.toggle("active", link.getAttribute("href") === "#" + id);
          });
        }
      });
    }, { passive: true });

    // 3. Mobile Navigation Drawer Toggle
    const mobileMenuToggle = document.getElementById("mobileMenuToggle");
    const mobileNavDrawer = document.getElementById("mobileNavDrawer");
    const drawerCloseButtons = document.querySelectorAll(".drawer-close");

    function toggleMobileDrawer() {
      const isOpen = mobileNavDrawer.classList.toggle("open");
      mobileMenuToggle.classList.toggle("open", isOpen);
      mobileMenuToggle.setAttribute("aria-expanded", isOpen);
      document.body.style.overflow = isOpen ? "hidden" : "";
    }

    mobileMenuToggle.addEventListener("click", toggleMobileDrawer);
    drawerCloseButtons.forEach(btn => {
      btn.addEventListener("click", () => {
        mobileNavDrawer.classList.remove("open");
        mobileMenuToggle.classList.remove("open");
        mobileMenuToggle.setAttribute("aria-expanded", "false");
        document.body.style.overflow = "";
      });
    });

    // 4. Smooth Scroll & Form Auto-Selection for Event Triggers
    document.querySelectorAll("[data-event]").forEach(cta => {
      cta.addEventListener("click", (e) => {
        const eventName = cta.dataset.event;
        const selectBox = document.getElementById("eventType");
        if (selectBox && eventName) {
          for (let opt of selectBox.options) {
            if (opt.value.includes(eventName) || eventName.includes(opt.value)) {
              opt.selected = true;
              break;
            }
          }
        }
      });
    });

    // 5. Scroll Reveal Animations (IntersectionObserver)
    const revealElements = document.querySelectorAll(".reveal-elem");
    const revealObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add("active");
          revealObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12, rootMargin: "0px 0px -40px 0px" });

    revealElements.forEach(el => revealObserver.observe(el));

    // 6. Complete Poster Archive Database (All Actual Images from D:\alladins\images)
    const posterItems = [
      {
        src: "images/wedding_ceremony_1793088006722.jpg",
        title: "Regal Wedding Stage & Mandap",
        tag: "Wedding Division",
        category: "events",
        alt: "Luxury wedding ceremony mandap and stage architecture setup"
      },
      {
        src: "images/catering_buffet_1793087525795.jpg",
        title: "Grand Catering Buffet & Chafers",
        tag: "Catering Services",
        category: "food",
        alt: "Professional event catering buffet setup"
      },
      {
        src: "images/food_biryani_1793087417367.jpg",
        title: "Signature Royal Dum Biryani",
        tag: "Culinary Speciality",
        category: "food",
        alt: "Traditional slow-cooked dum biryani in copper handi"
      },
      {
        src: "images/bread_halwa.png",
        title: "Traditional Bread Halwa",
        tag: "Traditional Sweets",
        category: "sweets",
        alt: "Rich and delicious Bread Halwa, made with soft bread and ghee"
      },
      {
        src: "images/paayasam.png",
        title: "Traditional Creamy Paayasam",
        tag: "Traditional Sweets",
        category: "sweets",
        alt: "Creamy traditional Paayasam, prepared with authentic flavours"
      },
      {
        src: "images/about_catering_1793087586187.jpg",
        title: "Attentive Banquet Service Team",
        tag: "Hospitality Care",
        category: "events",
        alt: "Courteous catering staff of ALADDIN'S serving banquet guests"
      },
      {
        src: "images/hero_banquet_1793087404132.jpg",
        title: "Grand Banquet Hall Setting",
        tag: "Banquet Orchestration",
        category: "events",
        alt: "Elegantly set luxury wedding banquet hall orchestrated by ALADDIN'S"
      },
      {
        src: "images/birthday_celebration_1793088021553.jpg",
        title: "Milestone Birthday Celebration",
        tag: "Theme Milestones",
        category: "events",
        alt: "Luxury birthday celebration with tiered cake and customized decorations"
      },
      {
        src: "images/outdoor_event_1793087605835.jpg",
        title: "Outdoor Lawn & Evening Gala",
        tag: "Al Fresco Receptions",
        category: "events",
        alt: "Outdoor evening wedding reception under fairy lights"
      },
      {
        src: "images/food_south_indian_1793087432379.jpg",
        title: "South Indian Banana Leaf Feast",
        tag: "Regional Classics",
        category: "food",
        alt: "Authentic South Indian spread served traditionally on banana leaf"
      },
      {
        src: "images/food_north_indian_1793087491275.jpg",
        title: "North Indian Mughlai Curries & Naan",
        tag: "Rich & Hearty",
        category: "food",
        alt: "Rich North Indian butter chicken, creamy dal makhani, and tandoori naan"
      },
      {
        src: "images/food_starters_1793087617216.jpg",
        title: "Artisanal Starters & Kebabs",
        tag: "First Impressions",
        category: "food",
        alt: "Golden samosas, paneer tikka skewers, and kebabs served with mint dip"
      },
      {
        src: "images/food_chinese_continental_1793087880762.jpg",
        title: "Indo-Chinese & Continental Specialities",
        tag: "Global Flavours",
        category: "food",
        alt: "Wok-tossed noodles, fried rice, and Indo-Chinese continental creations"
      }
    ];

    // 7. Render Masonry Gallery
    const galleryContainer = document.getElementById("galleryContainer");
    let activePosterIndex = 0;

    function renderGalleryItems(filter = "all") {
      galleryContainer.innerHTML = "";
      const filtered = filter === "all" ? posterItems : posterItems.filter(p => p.category === filter);

      filtered.forEach((item) => {
        const originalIndex = posterItems.findIndex(p => p.src === item.src);
        const card = document.createElement("div");
        card.className = "gallery-card-brick card-zoomable reveal-elem";
        card.setAttribute("tabindex", "0");
        card.setAttribute("role", "button");
        card.setAttribute("aria-label", "View " + item.title + " in full uncropped poster view");

        card.innerHTML = `
          <img src="${item.src}" alt="${item.alt}" loading="lazy" />
          <span class="poster-zoom-badge">&#x2922; View Poster</span>
          <div class="gallery-brick-hover">
            <span class="gallery-hover-tag-name">${item.tag}</span>
            <h4 class="gallery-hover-h4-title">${item.title}</h4>
          </div>
        `;

        card.addEventListener("click", () => openLightbox(originalIndex));
        card.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            openLightbox(originalIndex);
          }
        });

        galleryContainer.appendChild(card);
        revealObserver.observe(card);
      });
    }

    renderGalleryItems("all");

    // Gallery Filter Tabs
    document.querySelectorAll(".filter-btn-tab").forEach(tab => {
      tab.addEventListener("click", () => {
        document.querySelectorAll(".filter-btn-tab").forEach(t => t.classList.remove("active"));
        tab.classList.add("active");
        renderGalleryItems(tab.dataset.filter);
      });
    });

    // 8. Cinematic Fullscreen Lightbox Controls
    const lightboxModal = document.getElementById("lightboxModal");
    const lbImageElement = document.getElementById("lbImageElement");
    const lbTagElement = document.getElementById("lbTagElement");
    const lbTitleElement = document.getElementById("lbTitleElement");
    const lbCounterElement = document.getElementById("lbCounterElement");
    const lbCloseBtn = document.getElementById("lbCloseBtn");
    const lbPrevBtn = document.getElementById("lbPrevBtn");
    const lbNextBtn = document.getElementById("lbNextBtn");

    function updateLightboxDisplay() {
      const current = posterItems[activePosterIndex];
      lbImageElement.src = current.src;
      lbImageElement.alt = current.alt;
      lbTagElement.textContent = current.tag;
      lbTitleElement.textContent = current.title;
      lbCounterElement.textContent = (activePosterIndex + 1) + " of " + posterItems.length;
    }

    function openLightbox(index) {
      activePosterIndex = (index >= 0 && index < posterItems.length) ? index : 0;
      updateLightboxDisplay();
      lightboxModal.classList.add("active");
      document.body.style.overflow = "hidden";
      lbCloseBtn.focus();
    }

    function closeLightbox() {
      lightboxModal.classList.remove("active");
      document.body.style.overflow = "";
    }

    function prevLightboxSlide() {
      activePosterIndex = (activePosterIndex - 1 + posterItems.length) % posterItems.length;
      updateLightboxDisplay();
    }

    function nextLightboxSlide() {
      activePosterIndex = (activePosterIndex + 1) % posterItems.length;
      updateLightboxDisplay();
    }

    lbCloseBtn.addEventListener("click", closeLightbox);
    lbPrevBtn.addEventListener("click", prevLightboxSlide);
    lbNextBtn.addEventListener("click", nextLightboxSlide);

    lightboxModal.addEventListener("click", (e) => {
      if (e.target === lightboxModal || e.target.id === "lbContentHolder" || e.target.classList.contains("lightbox-image-box")) {
        closeLightbox();
      }
    });

    // Keyboard Shortcuts for Lightbox
    document.addEventListener("keydown", (e) => {
      if (!lightboxModal.classList.contains("active")) return;
      if (e.key === "Escape") closeLightbox();
      if (e.key === "ArrowLeft") prevLightboxSlide();
      if (e.key === "ArrowRight") nextLightboxSlide();
    });

    // Mobile Swipe Gestures for Lightbox
    let touchStartX = 0;
    let touchEndX = 0;
    lightboxModal.addEventListener("touchstart", (e) => {
      if (e.changedTouches && e.changedTouches.length > 0) {
        touchStartX = e.changedTouches[0].screenX;
      }
    }, { passive: true });

    lightboxModal.addEventListener("touchend", (e) => {
      if (e.changedTouches && e.changedTouches.length > 0) {
        touchEndX = e.changedTouches[0].screenX;
        const delta = touchEndX - touchStartX;
        if (Math.abs(delta) > 40) {
          if (delta > 0) prevLightboxSlide();
          else nextLightboxSlide();
        }
      }
    }, { passive: true });

    // Enable poster-trigger on all clickable images across the website
    document.querySelectorAll(".poster-trigger").forEach(trigger => {
      trigger.addEventListener("click", (e) => {
        if (e.target.closest("button") || e.target.closest("a") || e.target.closest(".event-link-cta")) return;
        const posterSrc = trigger.dataset.poster || (trigger.querySelector("img") ? trigger.querySelector("img").getAttribute("src") : "");
        if (posterSrc) {
          const cleanSrc = posterSrc.replace(/^[./]+/, '').split('?')[0];
          const foundIdx = posterItems.findIndex(p => p.src.includes(cleanSrc) || cleanSrc.includes(p.src));
          if (foundIdx !== -1) {
            openLightbox(foundIdx);
          } else {
            // Display singular modal (e.g. logo)
            lbImageElement.src = posterSrc;
            lbImageElement.alt = trigger.dataset.title || "ALADDIN'S Showcase";
            lbTagElement.textContent = trigger.dataset.tag || "ALADDIN'S Showcase";
            lbTitleElement.textContent = trigger.dataset.title || "Full Poster View";
            lbCounterElement.textContent = "1 of 1";
            lightboxModal.classList.add("active");
            document.body.style.overflow = "hidden";
            lbCloseBtn.focus();
          }
        }
      });

      trigger.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          if (e.target.closest("button") || e.target.closest("a")) return;
          e.preventDefault();
          trigger.click();
        }
      });
    });

    // 9. Interactive WhatsApp Enquiry Form (Direct to Sheik at 63838 16372)
    document.getElementById("enquiryForm").addEventListener("submit", function(e) {
      e.preventDefault();
      const name = document.getElementById("fullName").value.trim();
      const phone = document.getElementById("phone").value.trim();
      const eventType = document.getElementById("eventType").value;
      const eventDate = document.getElementById("eventDate").value;
      const guestCount = document.getElementById("guestCount").value;
      const details = document.getElementById("eventDetails").value.trim();
      const waNumber = "916383816372";

      if (!name) {
        alert("Please enter your full name.");
        document.getElementById("fullName").focus();
        return;
      }
      if (!phone) {
        alert("Please provide your phone or WhatsApp number.");
        document.getElementById("phone").focus();
        return;
      }
      if (!eventType) {
        alert("Please select your event type.");
        document.getElementById("eventType").focus();
        return;
      }

      let textMessage = `*New Event Enquiry \u2014 ALADDIN'S*\n\n` +
        `*Name:* ${name}\n` +
        `*Phone:* ${phone}\n` +
        `*Event Type:* ${eventType}\n`;

      if (eventDate) textMessage += `*Preferred Date:* ${eventDate}\n`;
      if (guestCount) textMessage += `*Approximate Guests:* ${guestCount}\n`;
      if (details) textMessage += `*Details & Requests:* ${details}\n`;
      textMessage += `\n_Submitted via ALADDIN'S website_`;

      const targetUrl = `https://wa.me/${waNumber}?text=${encodeURIComponent(textMessage)}`;
      window.open(targetUrl, "_blank", "noopener,noreferrer");
    });
  </script>
</body>
</html>