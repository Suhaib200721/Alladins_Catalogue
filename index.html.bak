  <main>
    <!-- ==========================================================================
         SECTION 1: HERO SECTION (LIGHT, BRIGHT & ELEGANT)
         ========================================================================== -->
    <section id="hero" aria-label="Welcome to ALADDIN'S">
      <div class="container">
        <div class="hero-split-grid">
          
          <div class="hero-text-content">
            <div class="section-badge-pill reveal-elem">
              <span>Bespoke Celebrations &bull; Haute Catering</span>
            </div>

            <h1 class="hero-headline-h1 reveal-elem delay-1">
              Crafting Memorable<br />
              <span class="teal-grad-text">Celebrations</span> with<br />
              <em>Exquisite Hospitality</em>
            </h1>

            <p class="hero-lead-paragraph reveal-elem delay-2">
              ALADDIN'S offers complete event management and authentic gourmet catering for weddings, royal banquets, corporate conclaves, and family celebrations &mdash; personally coordinated by Sheik.
            </p>

            <div class="hero-action-buttons reveal-elem delay-3">
              <a href="#contact" class="btn btn-teal">
                Plan Your Event &rarr;
              </a>
              <a href="#event-management" class="btn btn-outline-teal">
                Explore Our Services
              </a>
            </div>

            <div class="hero-metrics-strip reveal-elem delay-3">
              <div class="metric-card-block">
                <span class="metric-number-val">100%</span>
                <span class="metric-name-lbl">Customized Menus</span>
              </div>
              <div class="metric-card-block">
                <span class="metric-number-val">Signature</span>
                <span class="metric-name-lbl">Royal Dum Biryani</span>
              </div>
              <div class="metric-card-block">
                <span class="metric-number-val">Complete</span>
                <span class="metric-name-lbl">Stage &amp; Banquet Styling</span>
              </div>
            </div>
          </div>

          <div class="hero-canvas-col reveal-elem delay-2">
            <div class="hero-photo-frame card-zoomable poster-trigger" data-poster="images/hero_banquet_1793087404132.jpg" data-title="Grand Luxury Banquet Setting" data-tag="Banquets &amp; Receptions" tabindex="0" role="button" aria-label="Open Grand Banquet Hall poster in full lightbox">
              <img src="images/hero_banquet_1793087404132.jpg" alt="Luxuriously appointed grand wedding banquet hall orchestrated by ALADDIN'S" loading="eager" />
              <span class="poster-zoom-badge">&#x2922; View Poster</span>
            </div>

            <div class="hero-floating-badge-card">
              <p class="hero-badge-tag">Excellence in Execution</p>
              <h3 class="hero-badge-title">Orchestrated with Grace &amp; Precision</h3>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ==========================================================================
         SECTION 2: ABOUT US (SOFT CREAM BACKGROUND)
         ========================================================================== -->
    <section id="about" aria-labelledby="aboutSectionTitle">
      <div class="container">
        <div class="about-split-view">
          
          <div class="about-portrait-wrap reveal-elem">
            <div class="about-image-card card-zoomable poster-trigger" data-poster="images/about_catering_1793087586187.jpg" data-title="Our Catering Hospitality Team" data-tag="Hospitality Heritage" tabindex="0" role="button" aria-label="Open Hospitality Team poster in full lightbox">
              <img src="images/about_catering_1793087586187.jpg" alt="Professional catering team of ALADDIN'S serving guests at a luxury banquet" loading="lazy" />
              <span class="poster-zoom-badge">&#x2922; View Poster</span>
            </div>

            <div class="about-director-badge">
              <div class="badge-icon-teal">&#10022;</div>
              <h4 class="badge-director-name">Sheik</h4>
              <p class="badge-director-role">Lead Director &amp; Head of Hospitality</p>
            </div>
          </div>

          <div class="about-content-column">
            <div class="section-badge-pill reveal-elem">
              <span>About Us</span>
            </div>
            <h2 id="aboutSectionTitle" class="section-h2-title reveal-elem delay-1">
              Dedicated to the Art of <span class="teal-grad-text">Exceptional Hospitality</span>
            </h2>

            <p class="about-quote-lead reveal-elem delay-2">
              "We believe that a feast should be as memorable as the vows exchanged and the milestones commemorated."
            </p>

            <p class="about-body-text reveal-elem delay-2">
              At <strong>ALADDIN'S &ndash; Event Management &amp; Catering Services</strong>, we approach each gathering as a bespoke production. Combining time-honoured culinary recipes with progressive event coordination, we eliminate the friction between event staging, logistics, and gastronomic execution.
            </p>

            <div class="about-pillars-grid reveal-elem delay-3">
              <div class="pillar-box-card">
                <h4 class="pillar-h4-title">Authentic Flavours</h4>
                <p class="pillar-p-desc">Pure ingredients, freshly ground spices, and traditional recipes.</p>
              </div>
              <div class="pillar-box-card">
                <h4 class="pillar-h4-title">Tailored Décor</h4>
                <p class="pillar-p-desc">Custom stage design, lighting, and banquet hall aesthetics.</p>
              </div>
              <div class="pillar-box-card">
                <h4 class="pillar-h4-title">Direct Supervision</h4>
                <p class="pillar-p-desc">Personal coordination by Sheik ensuring seamless flow from start to finish.</p>
              </div>
              <div class="pillar-box-card">
                <h4 class="pillar-h4-title">Prompt Hospitality</h4>
                <p class="pillar-p-desc">Courteous, synchronized staff dedicated to attentive guest service.</p>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ==========================================================================
         SECTION 3: EVENT MANAGEMENT SERVICES (PURE WHITE BACKGROUND)
         ========================================================================== -->
    <section id="event-management" aria-labelledby="eventMgmtTitle">
      <div class="container">
        
        <div class="section-header-split">
          <div>
            <div class="section-badge-pill reveal-elem">
              <span>Comprehensive Coordination</span>
            </div>
            <h2 id="eventMgmtTitle" class="section-h2-title reveal-elem delay-1">
              Event Management <span class="teal-grad-text">Services</span>
            </h2>
          </div>
          <p class="section-subtitle-p reveal-elem delay-2">
            Complete event staging, audio-visual atmosphere, seating choreography, and ceremonial design tailored for your celebration.
          </p>
        </div>

        <div class="events-asymmetric-grid">
          
          <!-- Card 1: Weddings (Span 7) -->
          <article class="event-card-item col-span-7 card-zoomable poster-trigger reveal-elem" data-poster="images/wedding_ceremony_1793088006722.jpg" data-title="Regal Wedding Stage & Mandap Setup" data-tag="Signature Weddings" tabindex="0" role="button" aria-label="Open Wedding Stage poster in full lightbox">
            <div class="event-card-image-layer">
              <img src="images/wedding_ceremony_1793088006722.jpg" alt="Regal wedding ceremony mandap and opulent stage setting" loading="lazy" />
            </div>
            <div class="event-card-overlay-gradient"></div>
            <span class="poster-zoom-badge">&#x2922; View Poster</span>
            <div class="event-card-details">
              <p class="event-pill-tag">Signature Wedding Division</p>
              <h3 class="event-h3-title">Weddings &amp; Stage Design</h3>
              <p class="event-text-desc">Complete ceremonial coordination, majestic mandap designs, floral arches, entrance pathways, and VIP guest seating planned to perfection.</p>
              <a href="#contact" class="event-link-cta" data-event="Wedding Management">
                Enquire for Weddings &rarr;
              </a>
            </div>
          </article>

          <!-- Card 2: Birthdays & Family Milestones (Span 5) -->
          <article class="event-card-item col-span-5 card-zoomable poster-trigger reveal-elem delay-1" data-poster="images/birthday_celebration_1793088021553.jpg" data-title="Milestone Birthday & Celebration Décor" data-tag="Milestone Celebrations" tabindex="0" role="button" aria-label="Open Birthday Décor poster in full lightbox">
            <div class="event-card-image-layer">
              <img src="images/birthday_celebration_1793088021553.jpg" alt="Luxury birthday celebration with tiered cake and customized decorations" loading="lazy" />
            </div>
            <div class="event-card-overlay-gradient"></div>
            <span class="poster-zoom-badge">&#x2922; View Poster</span>
            <div class="event-card-details">
              <p class="event-pill-tag">Milestone Celebrations</p>
              <h3 class="event-h3-title">Birthdays &amp; Family Gatherings</h3>
              <p class="event-text-desc">Themed backdrop setups, balloon and floral styling, custom cake tables, and sound &amp; lighting coordination for joyful milestones.</p>
              <a href="#contact" class="event-link-cta" data-event="Birthday Celebrations">
                Plan Birthday Event &rarr;
              </a>
            </div>
          </article>

          <!-- Card 3: Outdoor Lawns & Receptions (Span 6) -->
          <article class="event-card-item col-span-6 card-zoomable poster-trigger reveal-elem" data-poster="images/outdoor_event_1793087605835.jpg" data-title="Al Fresco Lawn & Garden Receptions" data-tag="Outdoor Celebrations" tabindex="0" role="button" aria-label="Open Outdoor Reception poster in full lightbox">
            <div class="event-card-image-layer">
              <img src="images/outdoor_event_1793087605835.jpg" alt="Outdoor evening reception with fairy light canopy and garden setting" loading="lazy" />
            </div>
            <div class="event-card-overlay-gradient"></div>
            <span class="poster-zoom-badge">&#x2922; View Poster</span>
            <div class="event-card-details">
              <p class="event-pill-tag">Open Air Gatherings</p>
              <h3 class="event-h3-title">Outdoor Lawns &amp; Evening Galas</h3>
              <p class="event-text-desc">Garden fairy lights, waterproof canopies, ambient pathway lanterns, and comfortable open-sky dining setups for enchanting evenings.</p>
              <a href="#contact" class="event-link-cta" data-event="Outdoor Events">
                Plan Outdoor Event &rarr;
              </a>
            </div>
          </article>

