    <div style="text-align:center;font-size:0.85rem;color:var(--text-muted);">
      <p>Contact Person: <strong>Sheik</strong></p>
      <p style="margin-top:0.3rem;">WhatsApp: <a href="https://wa.me/916383816372" style="color:var(--teal-600);font-weight:700;">63838 16372</a></p>
